{
 "compilerOptions": {
   "target": "ES2020",
   "module": "Node16",
   "moduleResolution": "Node16",
   "rootDir": "./lib",
   "outDir": "./dist",
   "sourceMap": true,
   "strict": true,
   "esModuleInterop": true,
   "forceConsistentCasingInFileNames": true,
   "skipLibCheck": true
 },
 "include": ["lib/**/*.ts"],
 "exclude": ["node_modules", "dist"]
}
